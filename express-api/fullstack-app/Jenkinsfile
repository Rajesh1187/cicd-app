pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git 'https://github.com/your-repo/fullstack-app.git'
            }
        }

        stage('Backend Test') {
            steps {
                sh '''
                cd backend
                npm install
                npm test || true
                '''
            }
        }

        stage('Build Images') {
            steps {
                sh '''
                docker build -t backend:latest ./backend
                docker build -t frontend:latest ./frontend
                '''
            }
        }

        stage('Deploy to K8s') {
            steps {
                sh '''
                kubectl apply -f k8s/
                '''
            }
        }
    }
}
